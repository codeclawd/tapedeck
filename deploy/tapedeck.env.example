# tapedeck settings. Copy to ~/.config/tapedeck/env (chmod 600). Real environment variables override these.

# Required: the music folder your Navidrome server reads. Downloads land in <artist>/<album>/NN Title.m4a.
TAPEDECK_LIBRARY=~/Music/navidrome

# Seconds to wait between downloads in a batch, to keep the request rate low.
TAPEDECK_SLEEP=3-8

# Where tapedeck keeps its SQLite database and caches (default: ~/.local/share/tapedeck).
# TAPEDECK_DATA=

# Optional: route YouTube/Spotify traffic through an HTTP proxy, e.g. http://127.0.0.1:8080
# TAPEDECK_PROXY=

# Optional: a command to run when YouTube refuses audio (at most once every 2 h), e.g. to send you a notification.
# TAPEDECK_ON_STREAM_BLOCKED=

# Optional: ask Navidrome to rescan after each download or undo (needs an admin user).
# Useful when Navidrome's file watcher can't see the folder, for example through a Docker or VM mount.
# NAVIDROME_URL=http://localhost:4533
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=

# API tokens. `tapedeck token --init` writes these for you.
# TAPEDECK_OWNER_TOKEN=
# TAPEDECK_AGENT_TOKEN=
