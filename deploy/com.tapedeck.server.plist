<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tapedeck.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/user/.local/bin/tapedeck</string>
    <string>serve</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--port</string><string>4540</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- yt-dlp needs node (YouTube's JS challenge); launchd's default PATH doesn't include /usr/local/bin -->
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/user/.local/share/tapedeck/server.log</string>
  <key>StandardErrorPath</key><string>/Users/user/.local/share/tapedeck/server.log</string>
</dict>
</plist>
